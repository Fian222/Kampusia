{
  "name": "kampusia",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.1",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "dev": "bun run --parallel --filter web --filter api dev",
    "dev:web": "bun --filter web dev",
    "dev:api": "bun --filter api dev",
    "check": "bun run --workspaces check",
    "build": "bun run --filter api --filter web build",
    "test": "bun test",
    "db:generate": "bun --filter @kampusia/db db:generate",
    "db:check": "bun --filter @kampusia/db db:check",
    "db:migrate": "bun --filter @kampusia/db db:migrate",
    "db:studio": "bun --filter @kampusia/db db:studio"
  },
  "devDependencies": { "typescript": "^5.9.3", "@types/bun": "^1.3.0" }
}
